include(CMakeDependentOption)
cmake_dependent_option(LCF_ASYNC_STDEXEC_BUILD_TESTS "Provide stdexec development targets" ON "LCF_ASYNC_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_STDEXEC_BUILD_VERIFY "Provide stdexec verification" ON "LCF_ASYNC_STDEXEC_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_STDEXEC_BUILD_SANDBOX "Provide stdexec sandbox" ON "LCF_ASYNC_STDEXEC_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_STDEXEC_BUILD_BENCHMARKS "Provide stdexec benchmarks" OFF "LCF_ASYNC_STDEXEC_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_STDEXEC_TESTS_IN_MAIN_BUILD "Configure development executables in this build" OFF "LCF_ASYNC_STDEXEC_BUILD_TESTS" OFF)
foreach(async_dependency STDEXEC GTEST BENCHMARK)
    set(LCF_ASYNC_STDEXEC_${async_dependency}_PROVIDER "" CACHE STRING "Override dependency provider; empty inherits LCF_ASYNC_DEPENDENCY_PROVIDER")
    set_property(CACHE LCF_ASYNC_STDEXEC_${async_dependency}_PROVIDER PROPERTY STRINGS "" PACKAGE PROVIDED FETCH)
    mark_as_advanced(LCF_ASYNC_STDEXEC_${async_dependency}_PROVIDER)
endforeach()
