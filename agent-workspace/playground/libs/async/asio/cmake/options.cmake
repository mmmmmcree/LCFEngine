include(CMakeDependentOption)
cmake_dependent_option(LCF_ASYNC_ASIO_BUILD_TESTS "Provide Asio development targets" ON "LCF_ASYNC_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_ASIO_BUILD_VERIFY "Provide Asio verification" ON "LCF_ASYNC_ASIO_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_ASIO_BUILD_SANDBOX "Provide Asio sandbox" ON "LCF_ASYNC_ASIO_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_ASIO_BUILD_BENCHMARKS "Provide Asio benchmarks" ON "LCF_ASYNC_ASIO_BUILD_TESTS" OFF)
cmake_dependent_option(LCF_ASYNC_ASIO_TESTS_IN_MAIN_BUILD "Configure development executables in this build" OFF "LCF_ASYNC_ASIO_BUILD_TESTS" OFF)
set(LCF_ASYNC_ASIO_PROVIDER "" CACHE STRING "Override Asio provider; empty inherits library policy")
set_property(CACHE LCF_ASYNC_ASIO_PROVIDER PROPERTY STRINGS "" PACKAGE PROVIDED FETCH)
mark_as_advanced(LCF_ASYNC_ASIO_PROVIDER)
foreach(async_dependency GTEST BENCHMARK)
    set(LCF_ASYNC_ASIO_${async_dependency}_PROVIDER "" CACHE STRING "Override dependency provider; empty inherits library policy")
    set_property(CACHE LCF_ASYNC_ASIO_${async_dependency}_PROVIDER PROPERTY STRINGS "" PACKAGE PROVIDED FETCH)
    mark_as_advanced(LCF_ASYNC_ASIO_${async_dependency}_PROVIDER)
endforeach()
