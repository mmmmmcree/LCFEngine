include(FetchContent)
find_package(Threads REQUIRED)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../deps.json" async_dependencies)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../deps.json")
string(JSON async_dependency_count LENGTH "${async_dependencies}" dependencies)
if(async_dependency_count EQUAL 0)
    return()
endif()
math(EXPR async_last_dependency "${async_dependency_count} - 1")
foreach(async_index RANGE 0 ${async_last_dependency})
    string(JSON async_dependency GET "${async_dependencies}" dependencies ${async_index})
    string(JSON async_name GET "${async_dependency}" name)
    string(JSON async_repository GET "${async_dependency}" git)
    string(JSON async_revision GET "${async_dependency}" git_tag)
    string(JSON async_target GET "${async_dependency}" target)
    string(JSON async_package GET "${async_dependency}" package)
    if(TARGET "${async_target}")
        continue()
    endif()
    string(TOUPPER "${async_name}" async_upper_name)
    set(async_provider "${LCF_ASYNC_ASIO_PROVIDER}")
    if(NOT async_provider)
        set(async_provider "${LCF_ASYNC_DEPENDENCY_PROVIDER}")
    endif()
    if(async_provider STREQUAL "PROVIDED")
        message(FATAL_ERROR "PROVIDED requires ${async_target}")
    elseif(async_provider STREQUAL "PACKAGE")
        find_package(${async_package} CONFIG REQUIRED)
    elseif(async_provider STREQUAL "FETCH")
        FetchContent_GetProperties(${async_name})
        set(async_source_dir "${FETCHCONTENT_SOURCE_DIR_${async_upper_name}}")
        if(NOT async_source_dir AND ${async_name}_POPULATED)
            set(async_source_dir "${${async_name}_SOURCE_DIR}")
        endif()
        if(async_source_dir)
            get_filename_component(async_source_dir "${async_source_dir}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
            if(NOT IS_DIRECTORY "${async_source_dir}")
                message(FATAL_ERROR "The ${async_name} source override must be an existing directory")
            endif()
        else()
            include(ExternalProject)
            set(async_source_dir "${CMAKE_BINARY_DIR}/_deps/async-${async_name}/source")
            ExternalProject_Add(async_${async_name}_download
                PREFIX "${CMAKE_BINARY_DIR}/_deps/async-${async_name}" SOURCE_DIR "${async_source_dir}"
                GIT_REPOSITORY "${async_repository}" GIT_TAG "${async_revision}"
                CONFIGURE_COMMAND "" BUILD_COMMAND "" INSTALL_COMMAND "" EXCLUDE_FROM_ALL TRUE)
            set_target_properties(async_${async_name}_download PROPERTIES FOLDER "async/asio/dependencies")
        endif()
        set(${async_name}_SOURCE_DIR "${async_source_dir}")
        add_library("${async_target}" INTERFACE IMPORTED GLOBAL)
        if(TARGET async_${async_name}_download)
            add_dependencies("${async_target}" async_${async_name}_download)
        endif()
        string(JSON async_include_count LENGTH "${async_dependency}" include_directories)
        math(EXPR async_last_include "${async_include_count} - 1")
        foreach(async_include_index RANGE 0 ${async_last_include})
            string(JSON async_include GET "${async_dependency}" include_directories ${async_include_index})
            if(TARGET async_${async_name}_download)
                file(MAKE_DIRECTORY "${async_source_dir}/${async_include}")
            endif()
            if(IS_DIRECTORY "${async_source_dir}/${async_include}")
                target_include_directories("${async_target}" SYSTEM INTERFACE "${async_source_dir}/${async_include}")
            endif()
        endforeach()
        target_compile_definitions("${async_target}" INTERFACE ASIO_STANDALONE)
        target_link_libraries("${async_target}" INTERFACE Threads::Threads)
        if(WIN32)
            target_compile_definitions("${async_target}" INTERFACE _WIN32_WINNT=0x0601)
            target_link_libraries("${async_target}" INTERFACE ws2_32 mswsock)
        endif()
    else()
        message(FATAL_ERROR "Unknown provider for ${async_name}: ${async_provider}")
    endif()
    if(NOT TARGET "${async_target}")
        message(FATAL_ERROR "${async_name} did not provide the required target ${async_target}")
    endif()
endforeach()
