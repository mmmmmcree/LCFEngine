        },
        {
            "name": "stdexec-benchmark-debug",
            "configurePreset": "stdexec-benchmark",
            "configuration": "Debug"
        },
        {
            "name": "stdexec-benchmark-release",
            "configurePreset": "stdexec-benchmark",
            "configuration": "Release"
        },
        {
            "name": "compare-release",
            "configurePreset": "compare",
            "configuration": "Release",
            "targets": [
                "async_compare"
            ]
        },
        {
            "name": "ide-debug",
            "configurePreset": "ide",
            "configuration": "Debug"
        },
        {
            "name": "ide-release",
            "configurePreset": "ide",
            "configuration": "Release"
