include_guard(GLOBAL)
include(FetchContent)
function(async_test_dependency backend key target package content repository revision)
    if(TARGET ${target})
        return()
    endif()
    set(provider "${LCF_ASYNC_${backend}_${key}_PROVIDER}")
    if(NOT provider)
        set(provider "${LCF_ASYNC_DEPENDENCY_PROVIDER}")
    endif()
    if(provider STREQUAL "PROVIDED")
        message(FATAL_ERROR "PROVIDED requires ${target}; supply the target in the main build")
    elseif(provider STREQUAL "PACKAGE")
        find_package(${package} CONFIG REQUIRED)
    elseif(provider STREQUAL "FETCH")
        set(BUILD_GMOCK OFF)
        set(INSTALL_GTEST OFF)
        set(gtest_force_shared_crt ON)
        set(BENCHMARK_ENABLE_TESTING OFF)
        set(BENCHMARK_ENABLE_GTEST_TESTS OFF)
        set(BENCHMARK_ENABLE_INSTALL OFF)
        set(BENCHMARK_ENABLE_WERROR OFF)
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        FetchContent_Declare(${content} GIT_REPOSITORY "${repository}" GIT_TAG "${revision}")
        FetchContent_MakeAvailable(${content})
    else()
        message(FATAL_ERROR "Unknown ${key} provider: ${provider}")
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "${package} did not provide ${target}")
    endif()
endfunction()
