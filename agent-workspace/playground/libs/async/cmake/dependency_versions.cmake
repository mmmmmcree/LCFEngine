# List:   cmake -P path/to/dependency_versions.cmake
# Update: cmake -DAPPLY=ON -P path/to/dependency_versions.cmake
# Optional: -DDEPS_FILE=... -DCACHE_DIR=... -DDEPENDENCY=name -DCOUNT=5
# Dates mean tagger time for annotated tags, commit time for lightweight tags.
# No version parsing or stable/prerelease filtering is performed.
cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED DEPS_FILE)
    message(FATAL_ERROR "Set DEPS_FILE to the dependency manifest")
endif()
if(NOT DEFINED CACHE_DIR)
    set(CACHE_DIR "${CMAKE_CURRENT_BINARY_DIR}/build/dependency-versions")
endif()
if(NOT DEFINED COUNT)
    set(COUNT 5)
endif()
if(NOT COUNT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "COUNT must be a positive integer")
endif()
get_filename_component(DEPS_FILE "${DEPS_FILE}" ABSOLUTE)
get_filename_component(CACHE_DIR "${CACHE_DIR}" ABSOLUTE)
find_program(async_git NAMES git REQUIRED)

function(async_json_string value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(async_list_tags entry output)
    string(JSON async_name GET "${entry}" name)
    string(JSON async_repository GET "${entry}" git)
    string(SHA256 async_repository_key "${async_repository}")
    set(async_cache "${CACHE_DIR}/${async_repository_key}.git")
    file(MAKE_DIRECTORY "${CACHE_DIR}")
    file(LOCK "${async_cache}.lock" GUARD FUNCTION TIMEOUT 30)
    if(NOT EXISTS "${async_cache}/HEAD")
        execute_process(COMMAND "${async_git}" init --bare --quiet "${async_cache}"
            RESULT_VARIABLE async_git_result ERROR_VARIABLE async_git_error)
        if(NOT "${async_git_result}" STREQUAL "0")
            message(FATAL_ERROR "Cannot initialize tag cache: ${async_git_error}")
        endif()
    endif()

    message(STATUS "Fetching ${async_name} tag metadata...")
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env GIT_TERMINAL_PROMPT=0
            "${async_git}" "--git-dir=${async_cache}" fetch --quiet --force --prune
            --no-tags --depth=1 --filter=tree:0 -- "${async_repository}"
            "+refs/tags/*:refs/tags/*"
        RESULT_VARIABLE async_git_result ERROR_VARIABLE async_git_error TIMEOUT 120)
    if(NOT "${async_git_result}" STREQUAL "0")
        message(FATAL_ERROR "Cannot fetch ${async_name} tags (${async_git_result}): ${async_git_error}")
    endif()

    # The last sort key is primary. Equal timestamps use ascending tag names.
    execute_process(
        COMMAND "${async_git}" "--git-dir=${async_cache}" for-each-ref
            --sort=refname --sort=-creatordate
            "--format=%(creatordate:iso-strict)%09%(refname:strip=2)%09%(objecttype)"
            refs/tags
        RESULT_VARIABLE async_git_result OUTPUT_VARIABLE async_refs ERROR_VARIABLE async_git_error)
    if(NOT "${async_git_result}" STREQUAL "0")
        message(FATAL_ERROR "Cannot list ${async_name} tags: ${async_git_error}")
    endif()
    string(REPLACE ";" "\\;" async_refs "${async_refs}")
    string(REPLACE "\r" "" async_refs "${async_refs}")
    string(REPLACE "\n" ";" async_refs "${async_refs}")
    set(async_candidates "[]")
    set(async_count 0)
    foreach(async_ref IN LISTS async_refs)
        if(NOT async_ref MATCHES "^([^\t]+)\t([^\t]+)\t(.+)$")
            continue()
        endif()
        set(async_date "${CMAKE_MATCH_1}")
        set(async_tag "${CMAKE_MATCH_2}")
        set(async_type "${CMAKE_MATCH_3}")
        execute_process(
            COMMAND "${async_git}" "--git-dir=${async_cache}" rev-parse --verify "refs/tags/${async_tag}^{commit}"
            RESULT_VARIABLE async_git_result OUTPUT_VARIABLE async_commit
            ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT "${async_git_result}" STREQUAL "0")
            continue()
        endif()
        if(async_type STREQUAL "tag")
            set(async_date_source "tagger time")
        else()
            set(async_date_source "commit time")
        endif()
        set(async_candidate "{}")
        foreach(async_field IN ITEMS tag commit date date_source)
            async_json_string("${async_${async_field}}" async_encoded)
            string(JSON async_candidate SET "${async_candidate}" "${async_field}" "${async_encoded}")
        endforeach()
        string(JSON async_candidates SET "${async_candidates}" ${async_count} "${async_candidate}")
        math(EXPR async_count "${async_count} + 1")
        if(async_count GREATER_EQUAL COUNT)
            break()
        endif()
    endforeach()
    if(async_count EQUAL 0)
        message(FATAL_ERROR "${async_name}: no tags pointing to commits were found")
    endif()
    set(${output} "${async_candidates}" PARENT_SCOPE)
endfunction()

# Including this file exposes the query helpers without running the CLI.
if(NOT CMAKE_CURRENT_LIST_FILE STREQUAL CMAKE_SCRIPT_MODE_FILE AND NOT ASYNC_DEPENDENCY_VERSIONS_RUN_CLI)
    return()
endif()

file(READ "${DEPS_FILE}" async_original_json)
file(SHA256 "${DEPS_FILE}" async_original_hash)
set(async_updated_json "${async_original_json}")
string(JSON async_dependency_count LENGTH "${async_original_json}" dependencies)
if(async_dependency_count EQUAL 0)
    if(DEFINED DEPENDENCY)
        message(FATAL_ERROR "Dependency '${DEPENDENCY}' is not present in ${DEPS_FILE}")
    endif()
    message(STATUS "No dependencies to list")
    return()
endif()
math(EXPR async_last_dependency "${async_dependency_count} - 1")
set(async_names "")
foreach(async_index RANGE 0 ${async_last_dependency})
    string(JSON async_name GET "${async_original_json}" dependencies ${async_index} name)
    list(APPEND async_names "${async_name}")
endforeach()
if(DEFINED DEPENDENCY AND NOT DEPENDENCY IN_LIST async_names)
    message(FATAL_ERROR "Dependency '${DEPENDENCY}' is not present in ${DEPS_FILE}")
endif()

message(STATUS "Manifest: ${DEPS_FILE}")
message(STATUS "Order: newest Git timestamp first; tag names break ties; no stable/prerelease filter")
set(async_changed_count 0)
foreach(async_index RANGE 0 ${async_last_dependency})
    string(JSON async_entry GET "${async_original_json}" dependencies ${async_index})
    string(JSON async_name GET "${async_entry}" name)
    if(DEFINED DEPENDENCY AND NOT async_name STREQUAL DEPENDENCY)
        continue()
    endif()
    string(JSON async_current_revision GET "${async_entry}" git_tag)
    async_list_tags("${async_entry}" async_candidates)
    string(JSON async_candidate_count LENGTH "${async_candidates}")
    math(EXPR async_last_candidate "${async_candidate_count} - 1")
    message(STATUS "${async_name}: current git_tag = ${async_current_revision}")
    foreach(async_candidate_index RANGE 0 ${async_last_candidate})
        foreach(async_field IN ITEMS tag commit date date_source)
            string(JSON async_${async_field} GET "${async_candidates}" ${async_candidate_index} "${async_field}")
        endforeach()
        math(EXPR async_rank "${async_candidate_index} + 1")
        message(STATUS "  [${async_rank}] ${async_date} | ${async_tag} | ${async_date_source}")
        message(STATUS "      commit: ${async_commit}")
    endforeach()
    string(JSON async_latest_tag GET "${async_candidates}" 0 tag)
    string(JSON async_latest_commit GET "${async_candidates}" 0 commit)
    if(async_current_revision STREQUAL async_latest_commit)
        message(STATUS "  Already pinned to the first candidate (${async_latest_tag})")
        continue()
    endif()
    message(STATUS "  Update selection: ${async_latest_tag} -> ${async_latest_commit}")
    async_json_string("${async_latest_commit}" async_encoded)
    string(JSON async_updated_json SET "${async_updated_json}" dependencies ${async_index} git_tag "${async_encoded}")
    math(EXPR async_changed_count "${async_changed_count} + 1")
endforeach()

if(NOT APPLY)
    message(STATUS "List only: deps.json was not modified; ${async_changed_count} pins would change")
    message(STATUS "Copy a tag into git_tag, or build update_deps_to_latest to pin each first candidate's commit")
    return()
endif()
if(async_changed_count EQUAL 0)
    message(STATUS "No changes; no file was written")
    return()
endif()

# All queries must succeed before replacing the manifest.
file(SHA256 "${DEPS_FILE}" async_current_hash)
if(NOT async_current_hash STREQUAL async_original_hash)
    message(FATAL_ERROR "deps.json changed while tags were being queried; rerun the update")
endif()
string(APPEND async_updated_json "\n")
if(async_original_json MATCHES "\r\n")
    string(REPLACE "\n" "\r\n" async_updated_json "${async_updated_json}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef async_temporary_suffix)
set(async_temporary_file "${DEPS_FILE}.${async_temporary_suffix}.tmp")
file(WRITE "${async_temporary_file}" "${async_updated_json}")
file(RENAME "${async_temporary_file}" "${DEPS_FILE}" RESULT async_write_result)
if(NOT "${async_write_result}" STREQUAL "0")
    file(REMOVE "${async_temporary_file}")
    message(FATAL_ERROR "Cannot replace deps.json: ${async_write_result}")
endif()
message(STATUS "Updated ${async_changed_count} dependency pins in ${DEPS_FILE}")
message(STATUS "Build and run async_verify to check compatibility; dependency sources are fetched on their next build")
