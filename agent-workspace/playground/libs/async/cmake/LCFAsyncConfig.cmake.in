@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(LCFAsync_asio_FOUND @async_package_asio@)
set(LCFAsync_stdexec_FOUND @async_package_stdexec@)
if(NOT LCFAsync_FIND_COMPONENTS)
    if(LCFAsync_asio_FOUND)
        list(APPEND LCFAsync_FIND_COMPONENTS asio)
    endif()
    if(LCFAsync_stdexec_FOUND)
        list(APPEND LCFAsync_FIND_COMPONENTS stdexec)
    endif()
endif()
foreach(async_component IN LISTS LCFAsync_FIND_COMPONENTS)
    if(async_component STREQUAL "asio" AND LCFAsync_asio_FOUND)
        if(NOT TARGET asio::asio)
            find_dependency(asio CONFIG)
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/LCFAsyncAsioTargets.cmake")
    elseif(async_component STREQUAL "stdexec" AND LCFAsync_stdexec_FOUND)
        if(NOT TARGET STDEXEC::stdexec)
            find_dependency(STDEXEC CONFIG)
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/LCFAsyncStdexecTargets.cmake")
    else()
        set(LCFAsync_${async_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(LCFAsync)
