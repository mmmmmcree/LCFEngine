file(MAKE_DIRECTORY "${RESULTS_DIR}")
if(NOT REPORT_ONLY)
    foreach(backend ASIO STDEXEC)
        string(TOLOWER "${backend}" name)
        message(STATUS "Measuring ${name}: timing, poll latency, and allocations")
        foreach(kind BENCHMARK DIAGNOSTICS MEMORY)
            string(TOLOWER "${kind}" suffix)
            if(kind STREQUAL "BENCHMARK")
                set(arguments "--benchmark_out=${RESULTS_DIR}/${name}.json" --benchmark_out_format=json)
            else()
                set(arguments "${RESULTS_DIR}/${name}_${suffix}.csv")
            endif()
            set(log "${RESULTS_DIR}/${name}_${suffix}.log")
            execute_process(COMMAND "${${backend}_${kind}}" ${arguments} RESULT_VARIABLE result
                OUTPUT_FILE "${log}" ERROR_FILE "${log}")
            if(NOT "${result}" STREQUAL "0")
                message(FATAL_ERROR "${name} ${kind} failed: ${result}; see ${log}")
            endif()
        endforeach()
    endforeach()
endif()

function(csv_field value output)
    string(REPLACE "\"" "\"\"" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

file(WRITE "${RESULTS_DIR}/timing_raw.csv" "backend,case,real_time,time_unit,iterations,status\n")
foreach(name asio stdexec)
    file(READ "${RESULTS_DIR}/${name}.json" report)
    string(JSON count LENGTH "${report}" benchmarks)
    if(count EQUAL 0)
        continue()
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON test_case GET "${report}" benchmarks ${index} name)
        csv_field("${test_case}" case_field)
        string(JSON failed ERROR_VARIABLE no_failure GET "${report}" benchmarks ${index} error_occurred)
        if(NOT no_failure AND failed)
            file(APPEND "${RESULTS_DIR}/timing_raw.csv" "${name},${case_field},,,,error\n")
            continue()
        endif()
        string(JSON time GET "${report}" benchmarks ${index} real_time)
        string(JSON unit GET "${report}" benchmarks ${index} time_unit)
        string(JSON iterations GET "${report}" benchmarks ${index} iterations)
        file(APPEND "${RESULTS_DIR}/timing_raw.csv" "${name},${case_field},${time},${unit},${iterations},ok\n")
    endforeach()
endforeach()
execute_process(COMMAND "${REPORT_EXECUTABLE}" "${RESULTS_DIR}" RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Comparison report failed: ${result}; see ${RESULTS_DIR}/summary.md and the raw results")
endif()
message(STATUS "Backend comparison results: ${RESULTS_DIR}")
