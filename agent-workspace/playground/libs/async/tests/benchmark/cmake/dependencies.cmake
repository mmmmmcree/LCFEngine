set(LCF_ASYNC_BACKEND_BENCHMARK_PROVIDER "" CACHE STRING "Google Benchmark provider; empty inherits library policy")
set_property(CACHE LCF_ASYNC_BACKEND_BENCHMARK_PROVIDER PROPERTY STRINGS "" PACKAGE PROVIDED FETCH)
mark_as_advanced(LCF_ASYNC_BACKEND_BENCHMARK_PROVIDER)
if(TARGET benchmark::benchmark)
    return()
endif()
set(async_provider "${LCF_ASYNC_BACKEND_BENCHMARK_PROVIDER}")
if(NOT async_provider)
    set(async_provider "${LCF_ASYNC_DEPENDENCY_PROVIDER}")
endif()
if(async_provider STREQUAL "PACKAGE")
    find_package(benchmark CONFIG REQUIRED)
elseif(async_provider STREQUAL "PROVIDED")
    message(FATAL_ERROR "PROVIDED requires the benchmark::benchmark target")
elseif(async_provider STREQUAL "FETCH")
    include(FetchContent)
    set(BENCHMARK_ENABLE_TESTING OFF)
    set(BENCHMARK_ENABLE_GTEST_TESTS OFF)
    set(BENCHMARK_ENABLE_INSTALL OFF)
    set(BENCHMARK_ENABLE_WERROR OFF)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    FetchContent_Declare(googlebenchmark
        GIT_REPOSITORY https://github.com/google/benchmark.git
        GIT_TAG 192ef10025eb2c4cdd392bc502f0c852196baa48)
    FetchContent_MakeAvailable(googlebenchmark)
else()
    message(FATAL_ERROR "Unknown benchmark dependency provider: ${async_provider}")
endif()
