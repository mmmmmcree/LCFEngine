{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Async playground",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "LCF_ASYNC_USE_MODULES": "OFF"
            }
        },
        {
            "name": "msvc-2026",
            "displayName": "MSVC 2026 / module",
            "inherits": "dev",
            "binaryDir": "${sourceDir}/build/msvc-2026",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "LCF_ASYNC_USE_MODULES": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "clang",
            "displayName": "Clang / module",
            "inherits": "dev",
            "binaryDir": "${sourceDir}/build/clang",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "LCF_ASYNC_USE_MODULES": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "gcc",
            "displayName": "GCC / headers",
            "inherits": "dev",
            "binaryDir": "${sourceDir}/build/gcc",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "LCF_ASYNC_USE_MODULES": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "dev",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "dev",
            "configuration": "Release"
        },
        {
            "name": "msvc-2026-debug",
            "configurePreset": "msvc-2026",
            "configuration": "Debug"
        },
        {
            "name": "msvc-2026-release",
            "configurePreset": "msvc-2026",
            "configuration": "Release"
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang",
            "configuration": "Debug"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang",
            "configuration": "Release"
        },
        {
            "name": "gcc-debug",
            "configurePreset": "gcc",
            "configuration": "Debug"
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "dev",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "dev",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "msvc-2026-debug",
            "configurePreset": "msvc-2026",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "msvc-2026-release",
            "configurePreset": "msvc-2026",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-release",
            "configurePreset": "clang",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "gcc-debug",
            "configurePreset": "gcc",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
