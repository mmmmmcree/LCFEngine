cmake_minimum_required(VERSION 3.28)
find_program(test_git NAMES git REQUIRED)
get_filename_component(test_project "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(test_script "${test_project}/cmake/sync_deps.cmake")
set(test_query "${test_project}/libs/async/asio/cmake/dependency_versions.cmake")
if(NOT DEFINED TEST_DIR)
    set(TEST_DIR "${test_project}/build/dependency-script-tests")
endif()
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef test_suffix)
set(test_root "${TEST_DIR}/fixture ${test_suffix}")
set(test_repository "${test_root}/_deps/repository")
file(MAKE_DIRECTORY "${test_repository}" "${test_root}/libs/a" "${test_root}/libs/b")
set(test_a "${test_root}/libs/a/deps.json")
set(test_b "${test_root}/libs/b/deps.json")
set(test_top "${test_root}/deps.json")
set(test_date "2020-01-01T00:00:00+00:00")

function(test_run_git output)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "GIT_AUTHOR_DATE=${test_date}" "GIT_COMMITTER_DATE=${test_date}"
        "${test_git}" -C "${test_repository}"
        -c user.name=DependencyTest -c user.email=dependency-test@example.invalid ${ARGN}
        RESULT_VARIABLE test_result OUTPUT_VARIABLE test_stdout ERROR_VARIABLE test_stderr
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT "${test_result}" STREQUAL "0")
        message(FATAL_ERROR "Git fixture failed: ${test_stderr}")
    endif()
    set(${output} "${test_stdout}" PARENT_SCOPE)
endfunction()

function(test_run action expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT_DIR=${test_root}"
        "-DVERSION_SCRIPT=${test_query}" "-DACTION=${action}" ${ARGN} -P "${test_script}"
        RESULT_VARIABLE test_result OUTPUT_VARIABLE test_stdout ERROR_VARIABLE test_stderr)
    if(expected STREQUAL "success" AND NOT "${test_result}" STREQUAL "0")
        message(FATAL_ERROR "${action} failed: ${test_stdout}\n${test_stderr}")
    elseif(expected STREQUAL "failure" AND "${test_result}" STREQUAL "0")
        message(FATAL_ERROR "${action} unexpectedly succeeded: ${test_stdout}")
    endif()
    set(test_output "${test_stdout}\n${test_stderr}" PARENT_SCOPE)
endfunction()

function(test_get path output)
    file(READ "${path}" test_json)
    string(JSON test_value GET "${test_json}" ${ARGN})
    set(${output} "${test_value}" PARENT_SCOPE)
endfunction()

function(test_expect actual expected context)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${context}: expected '${expected}', got '${actual}'")
    endif()
endfunction()

test_run_git(test_unused init --quiet)
test_run_git(test_unused commit --allow-empty --quiet -m initial)
test_run_git(test_initial rev-parse HEAD)
test_run_git(test_unused tag v99.0.0)
set(test_date "2021-01-01T00:00:00+00:00")
test_run_git(test_unused commit --allow-empty --quiet -m next)
test_run_git(test_latest rev-parse HEAD)
test_run_git(test_unused tag v0.1.0)
set(test_date "2023-01-01T00:00:00+00:00")
test_run_git(test_unused tag -a nightly -m newest)
set(test_template [=[
{
    "marker": "preserve; child metadata",
    "dependencies": [
        {"name":"shared", "git":"@test_repository@", "git_tag":"@test_revision@", "target":"shared::shared", "custom":true}
    ]
}
]=])
set(test_revision v99.0.0)
string(CONFIGURE "${test_template}" test_a_original @ONLY)
file(WRITE "${test_a}" "${test_a_original}")
set(test_revision v0.1.0)
string(CONFIGURE "${test_template}" test_b_original @ONLY)
file(WRITE "${test_b}" "${test_b_original}")
foreach(test_ignored IN ITEMS build build-other cmake-build-debug _deps .hidden)
    file(MAKE_DIRECTORY "${test_root}/${test_ignored}/ignore")
    file(WRITE "${test_root}/${test_ignored}/ignore/deps.json" "invalid JSON: do not scan")
endforeach()
file(SHA256 "${test_a}" test_a_hash)
file(SHA256 "${test_b}" test_b_hash)

test_run(collect success)
test_get("${test_top}" test_entries dependencies)
string(JSON test_type TYPE "${test_entries}" 0 selected_git_tag)
test_expect("${test_type}" "NULL" "Conflicting defaults remain unresolved")
string(JSON test_sources LENGTH "${test_entries}" 0 sources)
test_expect("${test_sources}" "2" "Duplicate dependencies are merged")
test_get("${test_top}" test_source dependencies 0 sources 0 path)
test_expect("${test_source}" "libs/a/deps.json" "Sources are relative and deterministic")
file(SHA256 "${test_top}" test_top_hash)
test_run(collect success)
file(SHA256 "${test_top}" test_hash)
test_expect("${test_hash}" "${test_top_hash}" "Repeated collection is idempotent")
test_run(sync failure)
test_run(list success -DCOUNT=2)
if(NOT test_output MATCHES "nightly" OR test_output MATCHES "\\[3\\]")
    message(FATAL_ERROR "Listing must show time-sorted candidates and honor COUNT: ${test_output}")
endif()
foreach(test_path IN ITEMS a b top)
    file(SHA256 "${test_${test_path}}" test_hash)
    test_expect("${test_hash}" "${test_${test_path}_hash}" "Collect/list/failed sync leave source manifests unchanged")
endforeach()

file(READ "${test_top}" test_json)
string(JSON test_json SET "${test_json}" dependencies 0 selected_git_tag "\"v99.0.0\"")
string(JSON test_json SET "${test_json}" marker "\"preserve top metadata\"")
file(WRITE "${test_top}" "${test_json}\n")
test_run(collect success)
test_get("${test_top}" test_revision dependencies 0 selected_git_tag)
test_expect("${test_revision}" "v99.0.0" "Collection preserves manual selections")
test_run(sync success)
foreach(test_path IN ITEMS a b)
    test_get("${test_${test_path}}" test_revision dependencies 0 git_tag)
    test_expect("${test_revision}" "v99.0.0" "Manual tags are synchronized without requiring Git resolution")
    test_get("${test_${test_path}}" test_marker marker)
    test_expect("${test_marker}" "preserve; child metadata" "Child metadata is preserved")
    test_get("${test_${test_path}}" test_target dependencies 0 target)
    test_expect("${test_target}" "shared::shared" "Targets are preserved")
endforeach()
test_get("${test_top}" test_revision dependencies 0 sources 1 current_git_tag)
test_expect("${test_revision}" "v99.0.0" "Source index describes synchronized state")

file(MAKE_DIRECTORY "${test_root}/libs/c")
file(WRITE "${test_root}/libs/c/deps.json" "${test_b_original}")
test_run(collect success)
test_get("${test_top}" test_entries dependencies)
string(JSON test_sources LENGTH "${test_entries}" 0 sources)
test_expect("${test_sources}" "3" "New sources are discovered recursively")
test_get("${test_top}" test_revision dependencies 0 selected_git_tag)
test_expect("${test_revision}" "v99.0.0" "New children do not override manual choices")
file(REMOVE "${test_root}/libs/c/deps.json")
test_run(latest success)
foreach(test_path IN ITEMS a b top)
    if(test_path STREQUAL "top")
        test_get("${test_top}" test_revision dependencies 0 selected_git_tag)
    else()
        test_get("${test_${test_path}}" test_revision dependencies 0 git_tag)
    endif()
    test_expect("${test_revision}" "${test_latest}" "Latest pins the newest tag's peeled commit everywhere")
    file(SHA256 "${test_${test_path}}" test_${test_path}_hash)
endforeach()
test_get("${test_top}" test_marker marker)
test_expect("${test_marker}" "preserve top metadata" "Top metadata is preserved")
test_get("${test_top}" test_entries dependencies)
string(JSON test_sources LENGTH "${test_entries}" 0 sources)
test_expect("${test_sources}" "2" "Deleted sources are removed")
test_run(sync success)
test_run(latest success)
foreach(test_path IN ITEMS a b top)
    file(SHA256 "${test_${test_path}}" test_hash)
    test_expect("${test_hash}" "${test_${test_path}_hash}" "Repeated synchronization and latest are idempotent")
endforeach()

# A later failed remote query must not apply earlier successful selections.
file(READ "${test_a}" test_json)
set(test_broken "{\"name\":\"broken\",\"git\":\"${test_repository}/missing\",\"git_tag\":\"old\"}")
string(JSON test_json SET "${test_json}" dependencies 1 "${test_broken}")
file(WRITE "${test_a}" "${test_json}")
foreach(test_path IN ITEMS a b top)
    file(SHA256 "${test_${test_path}}" test_${test_path}_hash)
endforeach()
test_run(latest failure)
if(NOT test_output MATCHES "Cannot fetch broken")
    message(FATAL_ERROR "Expected a failed second remote query: ${test_output}")
endif()
foreach(test_path IN ITEMS a b top)
    file(SHA256 "${test_${test_path}}" test_hash)
    test_expect("${test_hash}" "${test_${test_path}_hash}" "Failed queries do not partially write any manifest")
endforeach()
file(READ "${test_b}" test_json)
string(JSON test_json SET "${test_json}" dependencies 0 git "\"${test_repository}/different\"")
file(WRITE "${test_b}" "${test_json}")
test_run(collect failure)
if(NOT test_output MATCHES "different repositories")
    message(FATAL_ERROR "Same-name repository conflicts must be diagnosed: ${test_output}")
endif()

file(WRITE "${test_a}" "${test_a_original}")
file(WRITE "${test_b}" "${test_b_original}")
file(READ "${test_top}" test_json)
string(JSON test_json SET "${test_json}" dependencies 0 git "\"${test_repository}/different\"")
file(WRITE "${test_top}" "${test_json}")
file(SHA256 "${test_top}" test_top_hash)
test_run(sync failure)
if(NOT test_output MATCHES "different repositories")
    message(FATAL_ERROR "A top-level repository mismatch must fail instead of selecting another Git source: ${test_output}")
endif()
file(SHA256 "${test_top}" test_hash)
test_expect("${test_hash}" "${test_top_hash}" "Repository conflicts leave the top-level manifest unchanged")
file(READ "${test_a}" test_json)
test_expect("${test_json}" "${test_a_original}" "Repository conflicts do not rewrite child manifests")

message(STATUS "Passed: recursive collection/exclusions, conflicts, read-only listing, manual selection, synchronization, metadata preservation, source refresh, chronological latest, commit pinning, idempotence, failed-query atomicity, repository validation")
message(STATUS "Fixtures: ${test_root}")
