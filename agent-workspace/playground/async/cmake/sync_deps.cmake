# cmake -DACTION=collect|list|sync|latest -DROOT_DIR=... -P sync_deps.cmake
# Optional: DEPS_FILE, CACHE_DIR, VERSION_SCRIPT, COUNT (list/latest only).
cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED ROOT_DIR)
    get_filename_component(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
get_filename_component(ROOT_DIR "${ROOT_DIR}" REALPATH)
if(NOT IS_DIRECTORY "${ROOT_DIR}")
    message(FATAL_ERROR "ROOT_DIR must be an existing source directory")
endif()
if(NOT DEFINED DEPS_FILE)
    set(DEPS_FILE "${ROOT_DIR}/deps.json")
endif()
get_filename_component(DEPS_FILE "${DEPS_FILE}" ABSOLUTE)
if(NOT DEFINED CACHE_DIR)
    set(CACHE_DIR "${ROOT_DIR}/build/dependency-versions")
endif()
if(NOT DEFINED VERSION_SCRIPT)
    set(VERSION_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/../libs/async/asio/cmake/dependency_versions.cmake")
endif()
if(NOT ACTION MATCHES "^(collect|list|sync|latest)$")
    message(FATAL_ERROR "ACTION must be collect, list, sync, or latest")
endif()
file(MAKE_DIRECTORY "${CACHE_DIR}")
string(SHA256 deps_root_key "${ROOT_DIR}")
file(LOCK "${CACHE_DIR}/${deps_root_key}.sync.lock" GUARD PROCESS TIMEOUT 30)

function(deps_json_string value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(deps_require_string entry field context output)
    string(JSON deps_type ERROR_VARIABLE deps_error TYPE "${entry}" "${field}")
    if(deps_error OR NOT deps_type STREQUAL "STRING")
        message(FATAL_ERROR "${context}: '${field}' must be a nonempty string")
    endif()
    string(JSON deps_value GET "${entry}" "${field}")
    if(deps_value STREQUAL "")
        message(FATAL_ERROR "${context}: '${field}' must be a nonempty string")
    endif()
    set(${output} "${deps_value}" PARENT_SCOPE)
endfunction()

function(deps_scan directory output)
    file(GLOB deps_children LIST_DIRECTORIES TRUE "${directory}/*")
    set(deps_paths "")
    foreach(deps_path IN LISTS deps_children)
        get_filename_component(deps_basename "${deps_path}" NAME)
        if(IS_SYMLINK "${deps_path}")
            continue()
        endif()
        if(IS_DIRECTORY "${deps_path}")
            if(deps_basename MATCHES "^(build($|[-_])|cmake-build-|_deps$|CMakeFiles$|\\.)")
                continue()
            endif()
            deps_scan("${deps_path}" deps_nested)
            list(APPEND deps_paths ${deps_nested})
        elseif(deps_basename STREQUAL "deps.json" AND NOT deps_path STREQUAL DEPS_FILE)
            list(APPEND deps_paths "${deps_path}")
        endif()
    endforeach()
    set(${output} "${deps_paths}" PARENT_SCOPE)
endfunction()

function(deps_commit paths)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef deps_suffix)
    set(deps_pending "")
    # Validate all snapshots and stage every file before replacing any original.
    set(deps_snapshots ${deps_manifests} "${DEPS_FILE}")
    foreach(deps_path IN LISTS deps_snapshots)
        string(SHA256 deps_key "${deps_path}")
        if(EXISTS "${deps_path}")
            file(SHA256 "${deps_path}" deps_current_hash)
        else()
            set(deps_current_hash "")
        endif()
        if(NOT deps_current_hash STREQUAL deps_${deps_key}_hash)
            message(FATAL_ERROR "${deps_path} changed during collection; rerun the command")
        endif()
    endforeach()
    foreach(deps_path IN LISTS paths)
        string(SHA256 deps_key "${deps_path}")
        set(deps_content "${deps_${deps_key}_updated}\n")
        string(REGEX REPLACE "[ \t]+\n" "\n" deps_content "${deps_content}")
        if(deps_${deps_key}_original MATCHES "\r\n")
            string(REPLACE "\n" "\r\n" deps_content "${deps_content}")
        endif()
        file(WRITE "${deps_path}.${deps_suffix}.tmp" "${deps_content}")
        list(APPEND deps_pending "${deps_path}")
    endforeach()
    set(deps_written "")
    foreach(deps_path IN LISTS deps_pending)
        file(RENAME "${deps_path}.${deps_suffix}.tmp" "${deps_path}" RESULT deps_result)
        if(NOT "${deps_result}" STREQUAL "0")
            set(deps_rollback_errors "")
            foreach(deps_previous IN LISTS deps_written)
                string(SHA256 deps_key "${deps_previous}")
                if(deps_${deps_key}_hash STREQUAL "")
                    file(REMOVE "${deps_previous}")
                else()
                    file(WRITE "${deps_previous}.${deps_suffix}.rollback" "${deps_${deps_key}_original}")
                    file(RENAME "${deps_previous}.${deps_suffix}.rollback" "${deps_previous}" RESULT deps_rollback)
                    if(NOT "${deps_rollback}" STREQUAL "0")
                        string(APPEND deps_rollback_errors "\nCannot restore ${deps_previous}: ${deps_rollback}")
                    endif()
                endif()
            endforeach()
            foreach(deps_previous IN LISTS deps_pending)
                file(REMOVE "${deps_previous}.${deps_suffix}.tmp")
            endforeach()
            message(FATAL_ERROR "Cannot replace ${deps_path}: ${deps_result}${deps_rollback_errors}")
        endif()
        list(APPEND deps_written "${deps_path}")
        message(STATUS "Wrote ${deps_path}")
    endforeach()
endfunction()

set(deps_existing "{\"dependencies\":[]}")
string(SHA256 deps_top_key "${DEPS_FILE}")
set(deps_${deps_top_key}_hash "")
set(deps_${deps_top_key}_original "")
if(EXISTS "${DEPS_FILE}")
    file(READ "${DEPS_FILE}" deps_existing)
    file(SHA256 "${DEPS_FILE}" deps_${deps_top_key}_hash)
    set(deps_${deps_top_key}_original "${deps_existing}")
endif()
string(JSON deps_existing_count LENGTH "${deps_existing}" dependencies)
set(deps_existing_keys "")
if(deps_existing_count GREATER 0)
    math(EXPR deps_last "${deps_existing_count} - 1")
    foreach(deps_index RANGE 0 ${deps_last})
        string(JSON deps_entry GET "${deps_existing}" dependencies ${deps_index})
        deps_require_string("${deps_entry}" name "${DEPS_FILE}" deps_name)
        string(SHA256 deps_key "${deps_name}")
        if(deps_key IN_LIST deps_existing_keys)
            message(FATAL_ERROR "${DEPS_FILE}: duplicate dependency '${deps_name}'")
        endif()
        list(APPEND deps_existing_keys "${deps_key}")
        set(deps_${deps_key}_existing "${deps_entry}")
    endforeach()
endif()

deps_scan("${ROOT_DIR}" deps_manifests)
list(SORT deps_manifests)
set(deps_keys "")
foreach(deps_path IN LISTS deps_manifests)
    string(SHA256 deps_manifest_key "${deps_path}")
    file(READ "${deps_path}" deps_json)
    file(SHA256 "${deps_path}" deps_${deps_manifest_key}_hash)
    set(deps_${deps_manifest_key}_original "${deps_json}")
    set(deps_${deps_manifest_key}_updated "${deps_json}")
    file(RELATIVE_PATH deps_relative "${ROOT_DIR}" "${deps_path}")
    string(JSON deps_count LENGTH "${deps_json}" dependencies)
    if(deps_count EQUAL 0)
        continue()
    endif()
    math(EXPR deps_last "${deps_count} - 1")
    foreach(deps_index RANGE 0 ${deps_last})
        string(JSON deps_entry GET "${deps_json}" dependencies ${deps_index})
        foreach(deps_field IN ITEMS name git git_tag)
            deps_require_string("${deps_entry}" "${deps_field}" "${deps_path}" deps_${deps_field})
        endforeach()
        string(SHA256 deps_key "${deps_name}")
        if(NOT deps_key IN_LIST deps_keys)
            list(APPEND deps_keys "${deps_key}")
            set(deps_${deps_key}_name "${deps_name}")
            set(deps_${deps_key}_git "${deps_git}")
            set(deps_${deps_key}_git_tag "${deps_git_tag}")
            set(deps_${deps_key}_conflict FALSE)
            set(deps_${deps_key}_sources "[]")
            set(deps_${deps_key}_source_count 0)
        elseif(NOT deps_git STREQUAL deps_${deps_key}_git)
            message(FATAL_ERROR "${deps_name}: different repositories in child manifests: ${deps_${deps_key}_git} and ${deps_git} (${deps_relative})")
        elseif(NOT deps_git_tag STREQUAL deps_${deps_key}_git_tag)
            set(deps_${deps_key}_conflict TRUE)
        endif()
        set(deps_source "{}")
        deps_json_string("${deps_relative}" deps_encoded)
        string(JSON deps_source SET "${deps_source}" path "${deps_encoded}")
        deps_json_string("${deps_git_tag}" deps_encoded)
        string(JSON deps_source SET "${deps_source}" current_git_tag "${deps_encoded}")
        string(JSON deps_${deps_key}_sources SET "${deps_${deps_key}_sources}"
            ${deps_${deps_key}_source_count} "${deps_source}")
        math(EXPR deps_${deps_key}_source_count "${deps_${deps_key}_source_count} + 1")
    endforeach()
endforeach()

set(deps_entries "[]")
set(deps_entry_count 0)
set(deps_unresolved "")
foreach(deps_key IN LISTS deps_keys)
    set(deps_name "${deps_${deps_key}_name}")
    set(deps_entry "{}")
    if(deps_${deps_key}_conflict)
        set(deps_revision "null")
    else()
        deps_json_string("${deps_${deps_key}_git_tag}" deps_revision)
    endif()
    if(deps_key IN_LIST deps_existing_keys)
        set(deps_entry "${deps_${deps_key}_existing}")
        deps_require_string("${deps_entry}" git "${DEPS_FILE}" deps_repository)
        if(NOT deps_repository STREQUAL deps_${deps_key}_git)
            message(FATAL_ERROR "${deps_name}: top and child manifests specify different repositories")
        endif()
        string(JSON deps_revision_type ERROR_VARIABLE deps_error TYPE "${deps_entry}" selected_git_tag)
        if(deps_error OR (NOT deps_revision_type STREQUAL "STRING" AND NOT deps_revision_type STREQUAL "NULL"))
            message(FATAL_ERROR "${DEPS_FILE}: ${deps_name}.selected_git_tag must be a nonempty string or null")
        endif()
        if(NOT deps_error AND deps_revision_type STREQUAL "STRING")
            deps_require_string("${deps_entry}" selected_git_tag "${DEPS_FILE}" deps_selected)
            deps_json_string("${deps_selected}" deps_revision)
        endif()
    endif()
    foreach(deps_field IN ITEMS name git)
        deps_json_string("${deps_${deps_key}_${deps_field}}" deps_encoded)
        string(JSON deps_entry SET "${deps_entry}" "${deps_field}" "${deps_encoded}")
    endforeach()
    string(JSON deps_entry SET "${deps_entry}" selected_git_tag "${deps_revision}")
    string(JSON deps_entry SET "${deps_entry}" sources "${deps_${deps_key}_sources}")
    string(JSON deps_entries SET "${deps_entries}" ${deps_entry_count} "${deps_entry}")
    set(deps_${deps_key}_index ${deps_entry_count})
    math(EXPR deps_entry_count "${deps_entry_count} + 1")
    if(deps_revision STREQUAL "null")
        list(APPEND deps_unresolved "${deps_name}")
        message(STATUS "${deps_name}: conflicting child versions; set selected_git_tag in ${DEPS_FILE} or use top_update_deps_to_latest")
    endif()
endforeach()

if(ACTION STREQUAL "list" OR ACTION STREQUAL "latest")
    include("${VERSION_SCRIPT}")
    foreach(deps_key IN LISTS deps_keys)
        set(deps_index ${deps_${deps_key}_index})
        string(JSON deps_entry GET "${deps_entries}" ${deps_index})
        string(JSON deps_current GET "${deps_entry}" selected_git_tag)
        message(STATUS "${deps_${deps_key}_name}: selected_git_tag = ${deps_current}")
        async_list_tags("${deps_entry}" deps_candidates)
        string(JSON deps_count LENGTH "${deps_candidates}")
        math(EXPR deps_last "${deps_count} - 1")
        foreach(deps_candidate_index RANGE 0 ${deps_last})
            foreach(deps_field IN ITEMS tag commit date date_source)
                string(JSON deps_${deps_field} GET "${deps_candidates}" ${deps_candidate_index} "${deps_field}")
            endforeach()
            math(EXPR deps_rank "${deps_candidate_index} + 1")
            message(STATUS "  [${deps_rank}] ${deps_date} | ${deps_tag} | ${deps_date_source}")
            message(STATUS "      commit: ${deps_commit}")
        endforeach()
        if(ACTION STREQUAL "latest")
            string(JSON deps_commit GET "${deps_candidates}" 0 commit)
            deps_json_string("${deps_commit}" deps_encoded)
            string(JSON deps_entries SET "${deps_entries}" ${deps_index} selected_git_tag "${deps_encoded}")
        endif()
    endforeach()
    if(ACTION STREQUAL "list")
        message(STATUS "List only: no dependency manifests were modified")
        return()
    endif()
elseif(ACTION STREQUAL "sync" AND deps_unresolved)
    message(FATAL_ERROR "Unresolved dependency versions: ${deps_unresolved}; edit the collected top-level deps.json first")
endif()

set(deps_changed_paths "")
if(ACTION STREQUAL "sync" OR ACTION STREQUAL "latest")
    foreach(deps_path IN LISTS deps_manifests)
        string(SHA256 deps_manifest_key "${deps_path}")
        set(deps_json "${deps_${deps_manifest_key}_original}")
        string(JSON deps_count LENGTH "${deps_json}" dependencies)
        if(deps_count EQUAL 0)
            continue()
        endif()
        math(EXPR deps_last "${deps_count} - 1")
        set(deps_changed FALSE)
        foreach(deps_index RANGE 0 ${deps_last})
            string(JSON deps_name GET "${deps_json}" dependencies ${deps_index} name)
            string(SHA256 deps_key "${deps_name}")
            string(JSON deps_selected GET "${deps_entries}" ${deps_${deps_key}_index} selected_git_tag)
            string(JSON deps_current GET "${deps_json}" dependencies ${deps_index} git_tag)
            if(NOT deps_current STREQUAL deps_selected)
                deps_json_string("${deps_selected}" deps_encoded)
                string(JSON deps_json SET "${deps_json}" dependencies ${deps_index} git_tag "${deps_encoded}")
                set(deps_changed TRUE)
            endif()
        endforeach()
        if(deps_changed)
            set(deps_${deps_manifest_key}_updated "${deps_json}")
            list(APPEND deps_changed_paths "${deps_path}")
        endif()
    endforeach()
    # The stored source index describes the manifests after synchronization.
    foreach(deps_key IN LISTS deps_keys)
        set(deps_index ${deps_${deps_key}_index})
        string(JSON deps_selected GET "${deps_entries}" ${deps_index} selected_git_tag)
        deps_json_string("${deps_selected}" deps_encoded)
        math(EXPR deps_last "${deps_${deps_key}_source_count} - 1")
        foreach(deps_source_index RANGE 0 ${deps_last})
            string(JSON deps_entries SET "${deps_entries}" ${deps_index} sources ${deps_source_index} current_git_tag "${deps_encoded}")
        endforeach()
    endforeach()
endif()

string(JSON deps_updated SET "${deps_existing}" dependencies "${deps_entries}")
string(JSON deps_canonical GET "${deps_existing}")
if(NOT deps_updated STREQUAL deps_canonical OR deps_${deps_top_key}_hash STREQUAL "")
    set(deps_${deps_top_key}_updated "${deps_updated}")
    list(APPEND deps_changed_paths "${DEPS_FILE}")
endif()
deps_commit("${deps_changed_paths}")
list(LENGTH deps_manifests deps_manifest_count)
list(LENGTH deps_changed_paths deps_changed_count)
message(STATUS "${ACTION}: ${deps_entry_count} dependencies from ${deps_manifest_count} child manifests; ${deps_changed_count} files changed")
