set(async_verify_tests_file "@CMAKE_CURRENT_BINARY_DIR@/verify-build/tests/verify/CTestTestfile.cmake")
if(EXISTS "${async_verify_tests_file}")
    include("${async_verify_tests_file}")
else()
    add_test(async.verify_build_required "@CMAKE_COMMAND@" -E echo "Build async_verify, then refresh the test list")
    set_tests_properties(async.verify_build_required PROPERTIES DISABLED TRUE LABELS async)
endif()
